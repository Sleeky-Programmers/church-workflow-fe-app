NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Church Workflow App
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional: only needed if the Mixpanel project uses EU data residency.
# Set to https://api-eu.mixpanel.com in that case, otherwise leave unset.
NEXT_PUBLIC_MIXPANEL_API_HOST=
# Optional: verification code from Google Search Console (Settings > Ownership verification > HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: set to "true" on a deployed test/QA environment (not real production) to enable
# the ?testLimit=... plan-limit preview params. See src/lib/dev/dev-flags.ts.
NEXT_PUBLIC_ENABLE_TEST_LIMITS=
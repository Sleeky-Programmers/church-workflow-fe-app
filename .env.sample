NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Church Workflow App
# Canonical production domain — used to build canonical URLs, sitemap
# entries, and Open Graph/Twitter absolute URLs. Should always be the
# production domain even in local .env files.
NEXT_PUBLIC_BASE_URL=https://churchworkflow.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional: only needed if the Mixpanel project uses EU data residency.
# Set to https://api-eu.mixpanel.com in that case, otherwise leave unset.
NEXT_PUBLIC_MIXPANEL_API_HOST=
# Optional: verification code from Google Search Console (Settings > Ownership verification > HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=